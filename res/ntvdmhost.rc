/*
 * ntvdmhost.rc -- embed the shared Common-Controls 6.0 manifest so the VDM host
 * window gets the XP Luna visual style (themed frame + menu). Reuses the same
 * XP-strict, comment-free manifest as ntvdmex (res/ntvdmex.manifest). See
 * res/ntvdmex.rc for the manifest gotchas. Define NTVDMEX_NO_MANIFEST to omit.
 */
#ifndef NTVDMEX_NO_MANIFEST
1 24 "ntvdmex.manifest"
#endif

/* Application icon -- shown by the shell on ntvdmhost.exe and (via the window
   class) in the title bar + taskbar. The lowest-numbered icon is the one the
   shell uses for the executable. */
#define IDI_MAINICON 101
IDI_MAINICON ICON "MAINICON.ico"

/* ── THE SETTINGS DIALOG. ────────────────────────────────────────────────────────
   Control IDs come from settings_ids.h, which src/host/settings.h includes too --
   one definition, both sides. DIALOGEX + "MS Shell Dlg" is what gets the themed XP
   look out of the manifest above; a plain DIALOG with a hard-coded font does not.
   Sizes are dialog units, not pixels, so this stays right at other DPI settings.

   IDD_SETTINGS is only the FRAME: a tab control, Restore Defaults, Apply, OK and
   Cancel. The six pages are separate child dialogs (DS_CONTROL | WS_CHILD, no
   caption, no border) that main.c creates and parks in the tab's display rectangle.
   DS_CONTROL is what makes a dialog usable as a page: it implies WS_EX_CONTROLPARENT,
   so Tab walks into and out of the page instead of stopping dead at its edge.

   ★ 640 x 480, WITH A FIXED SINGLE BORDER (user, s84). No DS_MODALFRAME: a thin,
     non-resizing frame. At 96 DPI one DLU is ~1.5 px across and ~1.63 px down, so the
     frame is 424 x 280 DLU (a few px over 480 tall, which the user allowed rather than
     crowd the Machine and Audio tabs). A page is ~404 x 228; content ends by y = 224.
   ★ THE GRID (the user's designs, one per tab):
       group box        x 6, width 392 (6..398), 4 DLU between groups
       inner margins    14 .. 390 -- a description spans the whole 376
       one-control rows label at 14, control in the right column x 240, width 150
       three-column rows columns start 14 / 140 / 266 (124 wide); label 58, control 64
       card jumpers     Address 214..256, IRQ 282..320, DMA 350..390 -- shared by the
                        Sound Blaster and Gravis Ultrasound rows so they line up
       path rows        edit to 334, Browse... at 340..390
       checkbox columns x 14 and x 202 (Drawing) or x 240 (Memory, the control column)
   Each group opens with a sentence saying what its settings do, where one is needed.

   ⚠ COMBO ITEMS ARE NOT LISTED HERE. Every drop-list is declared empty and filled at
     runtime from SET_DEFS in src/host/settings.h, so the item text and the stored
     index cannot drift apart. Editing a list means editing that table, not this file.
   ⚠ A COMBOBOX's height in a template is the height of its DROPPED LIST, not of the
     closed control -- an 80 there is normal and is not a layout mistake. */
#include "settings_ids.h"

#ifndef WS_CHILD
#define WS_CHILD           0x40000000L
#define WS_VISIBLE         0x10000000L
#define WS_GROUP           0x00020000L
#define WS_TABSTOP         0x00010000L
#define WS_BORDER          0x00800000L
#define WS_CAPTION         0x00C00000L
#define WS_SYSMENU         0x00080000L
#define WS_POPUP           0x80000000L
#define WS_CLIPSIBLINGS    0x04000000L
#define WS_VSCROLL         0x00200000L
#define DS_MODALFRAME      0x80L
#define DS_SETFONT         0x40L
#define DS_CENTER          0x0800L
#define DS_CONTROL         0x0400L
#define BS_AUTOCHECKBOX    0x00000003L
#define BS_GROUPBOX        0x00000007L
#define BS_AUTORADIOBUTTON 0x00000009L
#define BS_DEFPUSHBUTTON   0x00000001L
#define ES_AUTOHSCROLL     0x0080L
#define ES_NUMBER          0x2000L
#define CBS_DROPDOWN       0x0002L
#define CBS_DROPDOWNLIST   0x0003L
#define CBS_HASSTRINGS     0x0200L
#define CBS_OWNERDRAWFIXED 0x0010L
#define SS_LEFT            0x00000000L
#define SS_OWNERDRAW       0x0000000DL
#define CBS_SORT           0x0100L
#define IDOK               1
#define IDCANCEL           2
#endif

/* TCS_TABS is 0 and every other tab style here is a default, so the tab control
   needs no style bits of its own beyond the window ones. */

IDD_SETTINGS DIALOGEX 0, 0, 424, 280
STYLE DS_SETFONT | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Windows NT Virtual DOS Machine Settings"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    CONTROL         "", IDC_S_TAB, "SysTabControl32",
                    WS_CHILD | WS_VISIBLE | WS_TABSTOP | WS_CLIPSIBLINGS,
                    7, 7, 410, 246
    PUSHBUTTON      "Restore &Defaults", IDC_S_DEFAULTS, 7, 259, 80, 14
    PUSHBUTTON      "&Apply", IDC_S_APPLY, 259, 259, 50, 14
    DEFPUSHBUTTON   "OK", IDOK, 313, 259, 50, 14
    PUSHBUTTON      "Cancel", IDCANCEL, 367, 259, 50, 14
END

/* ── PAGE: MS-DOS ───────────────────────────────────────────────────────────────
   #203: the path box IS the shell setting (empty = XP's own); the radios only show
   and set that. The session line is filled at run time (s81: setting and session
   each get their own row). */
IDD_PAGE_GENERAL DIALOGEX 0, 0, 404, 228
STYLE DS_SETFONT | DS_CONTROL | WS_CHILD
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    GROUPBOX        "Shell", -1, 6, 4, 392, 64
    LTEXT           "You can use either Windows XP's built-in COMMAND.COM, or you can install "
                    "a custom version from a previous version of MS-DOS.",
                    -1, 14, 16, 376, 16
    CONTROL         "&Windows XP's own COMMAND.COM", IDC_S_SHELL_XP, "Button",
                    BS_AUTORADIOBUTTON | WS_TABSTOP | WS_GROUP, 14, 36, 200, 10
    CONTROL         "&Other:", IDC_S_SHELL_OWN, "Button",
                    BS_AUTORADIOBUTTON, 14, 50, 40, 10
    EDITTEXT        IDC_S_SHELL, 58, 48, 276, 13, ES_AUTOHSCROLL | WS_TABSTOP | WS_GROUP
    PUSHBUTTON      "&Browse...", IDC_S_SHELL_BROWSE, 340, 48, 50, 14, WS_TABSTOP

    GROUPBOX        "Version", -1, 6, 72, 392, 72
    LTEXT           "Some programs check the MS-DOS version and refuse to run if it is not the "
                    "one they support. You can choose which version is reported. 6.22 suits "
                    "almost everything. A change applies to programs started after the "
                    "version has been applied.",
                    IDC_S_DOSVER_NOTE, 14, 84, 376, 24
    LTEXT           "The current session is reporting:", IDC_S_DOSVER_NOW, 14, 112, 376, 8
    LTEXT           "&Reported MS-DOS Version:", -1, 14, 127, 200, 8
    COMBOBOX        IDC_S_DOSVER, 240, 125, 150, 90,
                    CBS_DROPDOWN | CBS_HASSTRINGS | WS_VSCROLL | WS_TABSTOP | WS_GROUP

    /* #167: where the two references answer differently. */
    GROUPBOX        "Behavior", -1, 6, 148, 392, 50
    LTEXT           "Genuine MS-DOS and NTVDM can answer programs differently. You can choose "
                    "whether this VDM copies genuine MS-DOS or NTVDM.",
                    -1, 14, 160, 376, 16
    LTEXT           "This VDM Behaves &Like:", -1, 14, 181, 200, 8
    COMBOBOX        IDC_S_BEHAVE, 240, 179, 150, 80,
                    CBS_DROPDOWNLIST | CBS_HASSTRINGS | WS_VSCROLL | WS_TABSTOP
END

/* ── PAGE: MACHINE ──────────────────────────────────────────────────────────────
   ⚠ THE OLD CPU PAGE WAS MOSTLY FICTION (session 60): Type, Core and Cycles were
   DOSBox vocabulary read by nothing. The processor is the user's own, running in
   V86, so the group SAYS that and offers the one real lever: a speed limit. */
IDD_PAGE_CPU DIALOGEX 0, 0, 404, 228
STYLE DS_SETFONT | DS_CONTROL | WS_CHILD
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    GROUPBOX        "Processor", -1, 6, 4, 392, 61
    LTEXT           "MS-DOS and 16-bit Windows programs run directly on your CPU, in "
                    "Virtual-8086 mode.",
                    -1, 14, 16, 376, 8
    LTEXT           "Your machine's CPU:", -1, 14, 25, 72, 8
    /* Filled at WM_INITDIALOG from the registry's ProcessorNameString -- see
       settings_fill_cpuinfo. The placeholder shows if that read ever fails. */
    LTEXT           "Unknown", IDC_S_CPUINFO, 88, 25, 302, 8
    LTEXT           "Some programs run too fast on a modern PC. You can throttle the CPU to "
                    "approximate an older, slower machine.",
                    -1, 14, 34, 376, 8
    LTEXT           "&Limit CPU Speed To:", -1, 14, 48, 200, 8
    /* #224: owner-drawn so rungs faster than this PC can be shown GREYED. */
    COMBOBOX        IDC_S_SPEEDMODE, 240, 46, 150, 140,
                    CBS_DROPDOWNLIST | CBS_OWNERDRAWFIXED | CBS_HASSTRINGS | WS_VSCROLL | WS_TABSTOP | WS_GROUP

    GROUPBOX        "Memory", -1, 6, 69, 392, 54
    LTEXT           "&Conventional Memory:", -1, 14, 83, 200, 8
    EDITTEXT        IDC_S_CONVKB, 240, 81, 132, 13, ES_AUTOHSCROLL | ES_NUMBER | WS_TABSTOP | WS_GROUP
    LTEXT           "KB", -1, 376, 83, 14, 8
    CONTROL         "&XMS (Extended Memory)", IDC_S_XMS, "Button",
                    BS_AUTOCHECKBOX | WS_TABSTOP, 14, 97, 180, 10
    CONTROL         "&EMS (Expanded Memory)", IDC_S_EMS, "Button",
                    BS_AUTOCHECKBOX | WS_TABSTOP, 240, 97, 150, 10
    CONTROL         "&UMB (Upper Memory Blocks)", IDC_S_UMB, "Button",
                    BS_AUTOCHECKBOX | WS_TABSTOP, 14, 108, 180, 10
    CONTROL         "&A20 Line Always Enabled", IDC_S_A20, "Button",
                    BS_AUTOCHECKBOX | WS_TABSTOP, 240, 108, 150, 10

    GROUPBOX        "Timing (Advanced)", -1, 6, 127, 392, 93
    LTEXT           "How the host paces the program's clock and its own redraw. Modifying these "
                    "settings is not recommended without good reason.",
                    -1, 14, 139, 376, 16
    CONTROL         "&Pace the Programmable Interval Timer (PIT) from a dedicated thread",
                    IDC_S_PITPACE, "Button", BS_AUTOCHECKBOX | WS_TABSTOP | WS_GROUP,
                    14, 159, 376, 10
    LTEXT           "How the host redraws the window. Auto redraws when the program finishes a "
                    "frame, waits for the vertical retrace, or at the display's refresh rate. "
                    "Alternatively, you can redraw at fixed, timed intervals.",
                    -1, 14, 173, 376, 24
    LTEXT           "&Screen Redraw Update:", -1, 14, 203, 200, 8
    COMBOBOX        IDC_S_UITICK, 240, 201, 150, 90,
                    CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
END

/* ── PAGE: VIDEO ────────────────────────────────────────────────────────────────
   s84 (user): Renderer is for the window AND fullscreen. The window still draws with
   GDI whichever is chosen -- DirectDraw applies to exclusive fullscreen -- until the
   STAGE2 `present` timing says a windowed DirectDraw path would buy anything. */
IDD_PAGE_DISPLAY DIALOGEX 0, 0, 404, 228
STYLE DS_SETFONT | DS_CONTROL | WS_CHILD
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    GROUPBOX        "Display", -1, 6, 4, 392, 51
    LTEXT           "The window's size is a multiple of the program's own screen size.",
                    -1, 14, 16, 376, 8
    LTEXT           "ALT+ENTER switches between the window and fullscreen at any time.",
                    -1, 14, 24, 376, 8
    LTEXT           "&Renderer:", -1, 14, 38, 58, 8
    COMBOBOX        IDC_S_RENDERER, 74, 36, 64, 80,
                    CBS_DROPDOWNLIST | CBS_HASSTRINGS | WS_VSCROLL | WS_TABSTOP | WS_GROUP
    LTEXT           "&Window Size:", -1, 140, 38, 58, 8
    COMBOBOX        IDC_S_WINSIZE, 200, 36, 64, 80,
                    CBS_DROPDOWNLIST | CBS_HASSTRINGS | WS_VSCROLL | WS_TABSTOP
    LTEXT           "Start F&ullscreen:", -1, 266, 38, 58, 8
    COMBOBOX        IDC_S_AUTOFS, 326, 36, 64, 80,
                    CBS_DROPDOWNLIST | CBS_HASSTRINGS | WS_VSCROLL | WS_TABSTOP

    /* s81 (#159): Aspect is a five-way setting (the View menu's list). */
    GROUPBOX        "Image", -1, 6, 59, 392, 61
    LTEXT           "How the program's picture is scaled, shaped, and colored on your screen.",
                    -1, 14, 71, 376, 8
    LTEXT           "&Scaler:", -1, 14, 87, 58, 8
    COMBOBOX        IDC_S_SCALER, 74, 85, 64, 80,
                    CBS_DROPDOWNLIST | CBS_HASSTRINGS | WS_VSCROLL | WS_TABSTOP | WS_GROUP
    LTEXT           "F&iltering:", -1, 140, 87, 58, 8
    COMBOBOX        IDC_S_FILTER, 200, 85, 64, 80,
                    CBS_DROPDOWNLIST | CBS_HASSTRINGS | WS_VSCROLL | WS_TABSTOP
    LTEXT           "&Aspect Ratio:", -1, 266, 87, 58, 8
    COMBOBOX        IDC_S_ASPECT, 326, 85, 64, 80,
                    CBS_DROPDOWNLIST | CBS_HASSTRINGS | WS_VSCROLL | WS_TABSTOP
    /* #229: the colour filter. */
    LTEXT           "&Color Filter:", -1, 14, 103, 58, 8
    COMBOBOX        IDC_S_TINT, 74, 101, 64, 80,
                    CBS_DROPDOWNLIST | CBS_HASSTRINGS | WS_VSCROLL | WS_TABSTOP
    LTEXT           "Frame S&kip:", -1, 140, 103, 58, 8
    COMBOBOX        IDC_S_FRAMESKIP, 200, 101, 64, 80,
                    CBS_DROPDOWNLIST | CBS_HASSTRINGS | WS_VSCROLL | WS_TABSTOP
    /* #325: maximised / fullscreen -- whole pixels or fill. */
    LTEXT           "Full Screen Fi&t:", -1, 266, 103, 58, 8
    COMBOBOX        IDC_S_FIT, 326, 101, 64, 80,
                    CBS_DROPDOWNLIST | CBS_HASSTRINGS | WS_VSCROLL | WS_TABSTOP

    /* #217: double-buffering and on-screen messages both default on. */
    GROUPBOX        "Drawing", -1, 6, 124, 392, 40
    CONTROL         "Force &VSync (Every Frame)", IDC_S_VSYNC, "Button",
                    BS_AUTOCHECKBOX | WS_TABSTOP | WS_GROUP, 14, 136, 180, 10
    CONTROL         "Use &Double-Buffering (Reduces Flicker)", IDC_S_BUFFERED, "Button",
                    BS_AUTOCHECKBOX | WS_TABSTOP, 202, 136, 188, 10
    CONTROL         "&Blink The Text Mode Cursor", IDC_S_BLINKCURSOR, "Button",
                    BS_AUTOCHECKBOX | WS_TABSTOP, 14, 148, 180, 10
    CONTROL         "Show On-Screen &Messages", IDC_S_OSD, "Button",
                    BS_AUTOCHECKBOX | WS_TABSTOP, 202, 148, 188, 10

    /* #321: any font installed on this PC, over the default character by character.
       The list is filled at run time from the installed fixed-pitch fonts; the preview
       is drawn from the tables a build for the selected font would produce. */
    GROUPBOX        "Text Mode Font", -1, 6, 168, 392, 56
    LTEXT           "&Font:", -1, 14, 180, 40, 8
    COMBOBOX        IDC_S_TEXTFONT, 56, 178, 160, 140,
                    CBS_DROPDOWNLIST | CBS_HASSTRINGS | CBS_SORT | WS_VSCROLL | WS_TABSTOP | WS_GROUP
    LTEXT           "", IDC_S_TEXTFONT_INFO, 222, 177, 168, 17
    CONTROL         "", IDC_S_TEXTFONT_VIEW, "Static", SS_OWNERDRAW, 14, 196, 376, 24
END

/* ── PAGE: AUDIO ────────────────────────────────────────────────────────────────
   Defaults describe the card we really emulate: SB16 at 220/IRQ 5/DMA 1, OPL3,
   44100 Hz. See the note over SET_DEFS in src/host/settings.h. */
IDD_PAGE_AUDIO DIALOGEX 0, 0, 404, 228
STYLE DS_SETFONT | DS_CONTROL | WS_CHILD
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    /* #234: WinMM or DirectSound; opened once, so it applies at the next program. */
    GROUPBOX        "Output", -1, 6, 4, 392, 51
    LTEXT           "How the sound reaches this PC's speakers. A change of output or sample "
                    "rate applies to programs started after the change has been applied.",
                    -1, 14, 16, 376, 16
    LTEXT           "Mi&xer:", -1, 14, 38, 24, 8
    COMBOBOX        IDC_S_AUDIOAPI, 40, 36, 70, 80,
                    CBS_DROPDOWNLIST | CBS_HASSTRINGS | WS_VSCROLL | WS_TABSTOP | WS_GROUP
    LTEXT           "Sample &Rate (Hz):", -1, 120, 38, 62, 8
    COMBOBOX        IDC_S_RATE, 184, 36, 48, 80,
                    CBS_DROPDOWNLIST | CBS_HASSTRINGS | WS_VSCROLL | WS_TABSTOP
    LTEXT           "Master &Volume:", -1, 244, 38, 52, 8
    EDITTEXT        IDC_S_VOLUME, 298, 36, 28, 13, ES_AUTOHSCROLL | ES_NUMBER | WS_TABSTOP
    CONTROL         "M&ute", IDC_S_MUTE, "Button",
                    BS_AUTOCHECKBOX | WS_TABSTOP, 346, 37, 44, 10

    GROUPBOX        "Music", -1, 6, 59, 392, 48
    LTEXT           "Ad&Lib / OPL Chip:", -1, 14, 73, 62, 8
    COMBOBOX        IDC_S_OPL, 78, 71, 118, 80,
                    CBS_DROPDOWNLIST | CBS_HASSTRINGS | WS_VSCROLL | WS_TABSTOP | WS_GROUP
    LTEXT           "M&IDI:", -1, 206, 73, 22, 8
    COMBOBOX        IDC_S_MIDI, 230, 71, 160, 80,
                    CBS_DROPDOWNLIST | CBS_HASSTRINGS | WS_VSCROLL | WS_TABSTOP
    LTEXT           "SoundF&ont:", -1, 14, 89, 40, 8
    EDITTEXT        IDC_S_SOUNDFONT, 58, 87, 276, 13, ES_AUTOHSCROLL | WS_TABSTOP
    PUSHBUTTON      "&Browse...", IDC_S_SF_BROWSE, 340, 87, 50, 14, WS_TABSTOP

    GROUPBOX        "Sound Blaster", -1, 6, 111, 392, 43
    LTEXT           "A program must be set up with the same address, IRQ, and DMA as "
                    "specified below.",
                    -1, 14, 123, 376, 8
    LTEXT           "Mo&del:", -1, 14, 137, 24, 8
    COMBOBOX        IDC_S_SBMODEL, 40, 135, 130, 80,
                    CBS_DROPDOWNLIST | CBS_HASSTRINGS | WS_VSCROLL | WS_TABSTOP | WS_GROUP
    LTEXT           "&Address:", -1, 180, 137, 32, 8
    COMBOBOX        IDC_S_SBADDR, 214, 135, 42, 80,
                    CBS_DROPDOWNLIST | CBS_HASSTRINGS | WS_VSCROLL | WS_TABSTOP
    LTEXT           "IR&Q:", -1, 264, 137, 16, 8
    COMBOBOX        IDC_S_SBIRQ, 282, 135, 38, 80,
                    CBS_DROPDOWNLIST | CBS_HASSTRINGS | WS_VSCROLL | WS_TABSTOP
    LTEXT           "D&MA:", -1, 328, 137, 20, 8
    COMBOBOX        IDC_S_SBDMA, 350, 135, 40, 80,
                    CBS_DROPDOWNLIST | CBS_HASSTRINGS | WS_VSCROLL | WS_TABSTOP

    /* #235: the GUS's jumpers, on the same columns as the Sound Blaster's. */
    GROUPBOX        "Gravis Ultrasound", -1, 6, 158, 392, 31
    CONTROL         "&Enabled", IDC_S_GUS, "Button",
                    BS_AUTOCHECKBOX | WS_TABSTOP, 14, 171, 80, 10
    LTEXT           "Address:", -1, 180, 172, 32, 8
    COMBOBOX        IDC_S_GUSADDR, 214, 170, 42, 80,
                    CBS_DROPDOWNLIST | CBS_HASSTRINGS | WS_VSCROLL | WS_TABSTOP
    LTEXT           "IRQ:", -1, 264, 172, 16, 8
    COMBOBOX        IDC_S_GUSIRQ, 282, 170, 38, 80,
                    CBS_DROPDOWNLIST | CBS_HASSTRINGS | WS_VSCROLL | WS_TABSTOP
    LTEXT           "DMA:", -1, 328, 172, 20, 8
    COMBOBOX        IDC_S_GUSDMA, 350, 170, 40, 80,
                    CBS_DROPDOWNLIST | CBS_HASSTRINGS | WS_VSCROLL | WS_TABSTOP

    GROUPBOX        "Other Devices", -1, 6, 193, 392, 31
    LTEXT           "PC Spea&ker:", -1, 14, 207, 44, 8
    COMBOBOX        IDC_S_SPEAKER, 60, 205, 136, 80,
                    CBS_DROPDOWNLIST | CBS_HASSTRINGS | WS_VSCROLL | WS_TABSTOP | WS_GROUP
    LTEXT           "MPU-401 &Port:", -1, 206, 207, 52, 8
    COMBOBOX        IDC_S_MPUADDR, 260, 205, 130, 80,
                    CBS_DROPDOWNLIST | CBS_HASSTRINGS | WS_VSCROLL | WS_TABSTOP
END

/* ── PAGE: INPUT ────────────────────────────────────────────────────────────────
   Sensitivity is LIVE. s84 (user): Show Host Mouse Cursor -- Always / Never / Smart,
   where Smart is #218's rule (hide after 5 s still over the video). */
IDD_PAGE_INPUT DIALOGEX 0, 0, 404, 228
STYLE DS_SETFONT | DS_CONTROL | WS_CHILD
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    GROUPBOX        "Mouse", -1, 6, 4, 392, 88
    LTEXT           "Click the video to capture the mouse, and press the WIN key to release it. "
                    "In seamless mode the program's pointer follows Windows' own pointer, and "
                    "no capture is needed.",
                    -1, 14, 16, 376, 24
    CONTROL         "&Seamless Mouse (No Capture Needed)", IDC_S_SEAMLESS, "Button",
                    BS_AUTOCHECKBOX | WS_TABSTOP | WS_GROUP, 14, 44, 376, 10
    LTEXT           "Show &Host Mouse Cursor:", -1, 14, 59, 200, 8
    COMBOBOX        IDC_S_HOSTCURSOR, 240, 57, 150, 80,
                    CBS_DROPDOWNLIST | CBS_HASSTRINGS | WS_VSCROLL | WS_TABSTOP
    LTEXT           "Se&nsitivity (while the mouse is captured):", -1, 14, 75, 220, 8
    CONTROL         "", IDC_S_MSENS, "msctls_trackbar32", 0x0010 | WS_TABSTOP, 236, 72, 124, 14
    LTEXT           "100%", IDC_S_MSENS_VAL, 362, 75, 28, 8

    GROUPBOX        "Keyboard", -1, 6, 96, 392, 31
    LTEXT           "&Layout:", -1, 14, 110, 28, 8
    COMBOBOX        IDC_S_KBLAYOUT, 44, 108, 106, 80,
                    CBS_DROPDOWNLIST | CBS_HASSTRINGS | WS_VSCROLL | WS_TABSTOP | WS_GROUP
    LTEXT           "&Typematic Rate:", -1, 170, 110, 56, 8
    EDITTEXT        IDC_S_TYPEMATIC, 228, 108, 30, 13, ES_AUTOHSCROLL | ES_NUMBER | WS_TABSTOP
    LTEXT           "Characters Per Second", -1, 262, 110, 128, 8

    GROUPBOX        "Joysticks && Gamepads", -1, 6, 131, 392, 31
    LTEXT           "T&ype:", -1, 14, 145, 22, 8
    COMBOBOX        IDC_S_JOYTYPE, 38, 143, 192, 80,
                    CBS_DROPDOWNLIST | CBS_HASSTRINGS | WS_VSCROLL | WS_TABSTOP | WS_GROUP
    CONTROL         "&Map to an XInput Gamepad", IDC_S_JOYPAD, "Button",
                    BS_AUTOCHECKBOX | WS_TABSTOP, 282, 144, 108, 10
END

/* ── PAGE: DRIVES ───────────────────────────────────────────────────────────────
   s84 (user): the VDM already reaches the host's drives, so there is no drive C
   folder and no boot choice. Each removable drive is the PHYSICAL one or a mounted
   image; with no physical drive, main.c greys that radio and selects the image. A
   blank image path is an empty drive. ⚠ Mounting: a floppy image reaches INT 13h
   today; mounting it as DOS drive A:, and ISO images at all, are open issues. */
IDD_PAGE_DRIVES DIALOGEX 0, 0, 404, 228
STYLE DS_SETFONT | DS_CONTROL | WS_CHILD
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    GROUPBOX        "Floppy Drive", -1, 6, 4, 392, 58
    LTEXT           "You can either use a physical floppy drive, or mount a floppy disk image.",
                    -1, 14, 16, 376, 8
    CONTROL         "Use The &Physical Floppy Drive", IDC_S_FLOPPY_PHYS, "Button",
                    BS_AUTORADIOBUTTON | WS_TABSTOP | WS_GROUP, 14, 30, 200, 10
    CONTROL         "&Mount Floppy Disk Image:", IDC_S_FLOPPY_IMG, "Button",
                    BS_AUTORADIOBUTTON, 14, 44, 100, 10
    EDITTEXT        IDC_S_FLOPPYA, 116, 42, 218, 13, ES_AUTOHSCROLL | WS_TABSTOP | WS_GROUP
    PUSHBUTTON      "&Browse...", IDC_S_FLOPPY_BROWSE, 340, 42, 50, 14, WS_TABSTOP

    GROUPBOX        "CD-ROM Drive", -1, 6, 66, 392, 58
    LTEXT           "You can either use a physical CD-ROM drive, or mount an ISO disk image.",
                    -1, 14, 78, 376, 8
    CONTROL         "Use The Physical &CD-ROM Drive", IDC_S_CD_PHYS, "Button",
                    BS_AUTORADIOBUTTON | WS_TABSTOP | WS_GROUP, 14, 92, 200, 10
    CONTROL         "Mount &ISO Disk Image:", IDC_S_CD_IMG, "Button",
                    BS_AUTORADIOBUTTON, 14, 106, 100, 10
    EDITTEXT        IDC_S_CDROM, 116, 104, 218, 13, ES_AUTOHSCROLL | WS_TABSTOP | WS_GROUP
    PUSHBUTTON      "B&rowse...", IDC_S_CD_BROWSE, 340, 104, 50, 14, WS_TABSTOP
END
