/*
 * ntvdmhost.rc -- embed the shared Common-Controls 6.0 manifest so the VDM host
 * window gets the XP Luna visual style (themed frame + menu). Reuses the same
 * XP-strict, comment-free manifest as ntvdmex (res/ntvdmex.manifest). See
 * res/ntvdmex.rc for the manifest gotchas. Define NTVDMEX_NO_MANIFEST to omit.
 */
#ifndef NTVDMEX_NO_MANIFEST
1 24 "ntvdmex.manifest"
#endif

/* Application icon -- shown by the shell on ntvdmhost.exe and (via the window
   class) in the title bar + taskbar. The lowest-numbered icon is the one the
   shell uses for the executable. */
#define IDI_MAINICON 101
IDI_MAINICON ICON "MAINICON.ico"

/* ── THE SETTINGS DIALOG. ────────────────────────────────────────────────────────
   Control IDs come from settings_ids.h, which src/host/settings.h includes too --
   one definition, both sides. DIALOGEX + "MS Shell Dlg" is what gets the themed XP
   look out of the manifest above; a plain DIALOG with a hard-coded font does not.
   Sizes are dialog units, not pixels, so this stays right at other DPI settings.

   IDD_SETTINGS is only the FRAME: a tab control, Restore Defaults, Apply, OK and
   Cancel. The eight pages are separate child dialogs (DS_CONTROL | WS_CHILD, no
   caption, no border) that main.c creates and parks in the tab's display rectangle.
   DS_CONTROL is what makes a dialog usable as a page: it implies WS_EX_CONTROLPARENT,
   so Tab walks into and out of the page instead of stopping dead at its edge.

   ★ IT MUST FIT AN 800 x 600 SCREEN (user, s84: era-correct resolutions). With XP's
     taskbar that leaves ~570 px for the whole window, i.e. ~320 DLU of dialog at
     96 DPI (1 DLU ~ 1.65 px down, ~1.5 px across). The frame is 400 x 315; a page's
     content must end by y = 246. A page that would not fit is split into two tabs
     rather than squeezed: Window/Graphics and Audio/Sound Cards were one each.
   ★ ONE GRID FOR EVERY PAGE (s84, the user's redesign). A page is ~380 x 250 DLU.
       group box        x 6, width 368 (6..374), 6 DLU between groups
       inner margins    16 .. 364 -- a description spans the whole 348
       row label        x 16, up to 192 wide, 2 DLU below its control's top
       control column   x 214, width 150 -- EVERY dropdown sits here, so they line up
                        down the page and from tab to tab; a unit ("KB", "%") goes
                        inside the column, after a shorter box
       path boxes       x 80 .. 364 (or .. 310 plus Browse), because a path needs room
       checkbox columns x 16 and x 192, 170 wide
       rows             16 DLU apart; a group ends 7-8 DLU under its last control
   Each group opens with a sentence saying what its settings do, where one is needed.

   ⚠ COMBO ITEMS ARE NOT LISTED HERE. Every drop-list is declared empty and filled at
     runtime from SET_DEFS in src/host/settings.h, so the item text and the stored
     index cannot drift apart. Editing a list means editing that table, not this file.
   ⚠ A COMBOBOX's height in a template is the height of its DROPPED LIST, not of the
     closed control -- an 80 there is normal and is not a layout mistake. */
#include "settings_ids.h"

#ifndef WS_CHILD
#define WS_CHILD           0x40000000L
#define WS_VISIBLE         0x10000000L
#define WS_GROUP           0x00020000L
#define WS_TABSTOP         0x00010000L
#define WS_BORDER          0x00800000L
#define WS_CAPTION         0x00C00000L
#define WS_SYSMENU         0x00080000L
#define WS_POPUP           0x80000000L
#define WS_CLIPSIBLINGS    0x04000000L
#define WS_VSCROLL         0x00200000L
#define DS_MODALFRAME      0x80L
#define DS_SETFONT         0x40L
#define DS_CENTER          0x0800L
#define DS_CONTROL         0x0400L
#define BS_AUTOCHECKBOX    0x00000003L
#define BS_GROUPBOX        0x00000007L
#define BS_AUTORADIOBUTTON 0x00000009L
#define BS_DEFPUSHBUTTON   0x00000001L
#define ES_AUTOHSCROLL     0x0080L
#define ES_NUMBER          0x2000L
#define CBS_DROPDOWN       0x0002L
#define CBS_DROPDOWNLIST   0x0003L
#define CBS_HASSTRINGS     0x0200L
#define CBS_OWNERDRAWFIXED 0x0010L
#define SS_LEFT            0x00000000L
#define IDOK               1
#define IDCANCEL           2
#endif

/* TCS_TABS is 0 and every other tab style here is a default, so the tab control
   needs no style bits of its own beyond the window ones. */

IDD_SETTINGS DIALOGEX 0, 0, 400, 315
STYLE DS_MODALFRAME | DS_SETFONT | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Windows NT Virtual DOS Machine Settings"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    CONTROL         "", IDC_S_TAB, "SysTabControl32",
                    WS_CHILD | WS_VISIBLE | WS_TABSTOP | WS_CLIPSIBLINGS,
                    7, 7, 386, 281
    PUSHBUTTON      "Restore &Defaults", IDC_S_DEFAULTS, 7, 294, 80, 14
    PUSHBUTTON      "&Apply", IDC_S_APPLY, 235, 294, 50, 14
    DEFPUSHBUTTON   "OK", IDOK, 289, 294, 50, 14
    PUSHBUTTON      "Cancel", IDCANCEL, 343, 294, 50, 14
END

/* ── PAGE: MS-DOS (was General) ─────────────────────────────────────────────────
   Which shell, and what machine programs are told they are on. */
IDD_PAGE_GENERAL DIALOGEX 0, 0, 380, 250
STYLE DS_SETFONT | DS_CONTROL | WS_CHILD
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    /* #203: which COMMAND.COM the prompt runs. The path box IS the setting (empty =
       XP's own); the radios only show and set that, so they are not table rows. */
    GROUPBOX        "MS-DOS shell", -1, 6, 4, 368, 66
    CONTROL         "Use &Windows XP's own COMMAND.COM", IDC_S_SHELL_XP, "Button",
                    BS_AUTORADIOBUTTON | WS_TABSTOP | WS_GROUP, 16, 18, 300, 10
    LTEXT           "Or you can use an older MS-DOS shell; for example, COMMAND.COM from "
                    "MS-DOS 6.22.",
                    -1, 16, 33, 348, 8
    CONTROL         "An&other:", IDC_S_SHELL_OWN, "Button",
                    BS_AUTORADIOBUTTON, 16, 50, 60, 10
    EDITTEXT        IDC_S_SHELL, 80, 48, 230, 13, ES_AUTOHSCROLL | WS_TABSTOP | WS_GROUP
    PUSHBUTTON      "&Browse...", IDC_S_SHELL_BROWSE, 314, 48, 50, 14, WS_TABSTOP

    /* s81 (user): the SETTING and the SESSION each get their own row. The session's
       row is filled at run time; the line under it says why they differ, and is
       empty when they do not. */
    GROUPBOX        "MS-DOS version", -1, 6, 76, 368, 130
    LTEXT           "Some programs check the MS-DOS version and refuse to run if it is not "
                    "one they support. You can choose which version is reported; 6.22 suits "
                    "almost everything. A change applies to programs started afterwards.",
                    IDC_S_DOSVER_NOTE, 16, 90, 348, 24
    LTEXT           "The current session is reporting:", -1, 16, 118, 192, 8
    RTEXT           "", IDC_S_DOSVER_NOW, 214, 118, 150, 8
    LTEXT           "", IDC_S_DOSVER_WHY, 16, 128, 348, 16
    LTEXT           "&Reported MS-DOS version:", -1, 16, 148, 192, 8
    COMBOBOX        IDC_S_DOSVER, 214, 146, 150, 90,
                    CBS_DROPDOWN | CBS_HASSTRINGS | WS_VSCROLL | WS_TABSTOP | WS_GROUP
    /* #167: where the two references answer differently. */
    LTEXT           "Where genuine MS-DOS 6.22 and Windows XP's NTVDM would answer a "
                    "program differently, you can choose which of the two machines this "
                    "VDM copies.",
                    -1, 16, 166, 348, 16
    LTEXT           "Where MS-DOS and NTVDM differ, behave &like:", -1, 16, 188, 192, 8
    COMBOBOX        IDC_S_BEHAVE, 214, 186, 150, 80,
                    CBS_DROPDOWNLIST | CBS_HASSTRINGS | WS_VSCROLL | WS_TABSTOP
END

/* ── PAGE: MACHINE (was Processor, Memory and Advanced) ─────────────────────────
   ⚠ THE OLD CPU PAGE WAS MOSTLY FICTION (session 60): Type, Core and Cycles were
   DOSBox vocabulary read by nothing. There is nothing to configure about the
   processor -- it is the user's own, running in V86 -- so the group SAYS that and
   offers the one real lever: an optional speed limit. Timing is internal pacing,
   last on the page because most people never touch it. */
IDD_PAGE_CPU DIALOGEX 0, 0, 380, 250
STYLE DS_SETFONT | DS_CONTROL | WS_CHILD
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    GROUPBOX        "Processor", -1, 6, 4, 368, 74
    LTEXT           "MS-DOS and 16-bit Windows programs run directly on your real CPU, in "
                    "Virtual-8086 mode.",
                    -1, 16, 18, 348, 8
    LTEXT           "Your machine's CPU:", -1, 16, 30, 90, 8
    /* Filled at WM_INITDIALOG from the registry's ProcessorNameString -- see
       settings_fill_cpuinfo. The placeholder shows if that read ever fails. */
    RTEXT           "Unknown", IDC_S_CPUINFO, 110, 30, 254, 8
    LTEXT           "Some programs run too fast on a modern PC; a speed limit slows them "
                    "down. The speeds are approximate.",
                    -1, 16, 44, 348, 8
    LTEXT           "&Limit CPU speed to:", -1, 16, 60, 192, 8
    /* #224: owner-drawn so rungs faster than this PC can be shown GREYED. */
    COMBOBOX        IDC_S_SPEEDMODE, 214, 58, 150, 140,
                    CBS_DROPDOWNLIST | CBS_OWNERDRAWFIXED | CBS_HASSTRINGS | WS_VSCROLL | WS_TABSTOP | WS_GROUP

    GROUPBOX        "Memory", -1, 6, 84, 368, 62
    LTEXT           "Con&ventional memory:", -1, 16, 100, 192, 8
    EDITTEXT        IDC_S_CONVKB, 214, 98, 134, 13, ES_AUTOHSCROLL | ES_NUMBER | WS_TABSTOP | WS_GROUP
    LTEXT           "KB", -1, 352, 100, 12, 8
    CONTROL         "&XMS (extended memory)", IDC_S_XMS, "Button",
                    BS_AUTOCHECKBOX | WS_TABSTOP, 16, 118, 170, 10
    CONTROL         "&EMS (expanded memory)", IDC_S_EMS, "Button",
                    BS_AUTOCHECKBOX | WS_TABSTOP, 192, 118, 170, 10
    CONTROL         "&UMB (upper memory blocks)", IDC_S_UMB, "Button",
                    BS_AUTOCHECKBOX | WS_TABSTOP, 16, 130, 170, 10
    CONTROL         "&A20 line always enabled", IDC_S_A20, "Button",
                    BS_AUTOCHECKBOX | WS_TABSTOP, 192, 130, 170, 10

    GROUPBOX        "Timing", -1, 6, 152, 368, 90
    LTEXT           "How the host paces the program's clock and its own redraw. Leave these "
                    "alone unless something tells you otherwise.",
                    -1, 16, 166, 348, 16
    CONTROL         "&Pace the Programmable Interval Timer (PIT) from a dedicated thread "
                    "(keeps timer ticks even)",
                    IDC_S_PITPACE, "Button", BS_AUTOCHECKBOX | WS_TABSTOP | WS_GROUP,
                    16, 186, 348, 10
    LTEXT           "Auto redraws the window each time the program finishes a frame (when "
                    "it waits for the vertical retrace), or at the display's rate if it "
                    "never does. A fixed interval redraws on a timer.",
                    -1, 16, 202, 348, 16
    LTEXT           "&Screen update:", -1, 16, 224, 192, 8
    COMBOBOX        IDC_S_UITICK, 214, 222, 150, 90,
                    CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
END

/* ── PAGE: WINDOW (split from Graphics so the dialog fits 800 x 600) ───────────
   s81 (#147): the window is always GDI; DirectDraw makes FULLSCREEN the exclusive
   DirectDraw mode instead of a borderless GDI window, so the renderer lives with
   fullscreen. */
IDD_PAGE_WINDOW DIALOGEX 0, 0, 380, 250
STYLE DS_SETFONT | DS_CONTROL | WS_CHILD
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    GROUPBOX        "Window", -1, 6, 4, 368, 46
    LTEXT           "The window's size is a multiple of the program's own screen size.",
                    -1, 16, 18, 348, 8
    LTEXT           "&Window size:", -1, 16, 32, 192, 8
    COMBOBOX        IDC_S_WINSIZE, 214, 30, 150, 80,
                    CBS_DROPDOWNLIST | CBS_HASSTRINGS | WS_VSCROLL | WS_TABSTOP | WS_GROUP

    GROUPBOX        "Fullscreen", -1, 6, 56, 368, 64
    LTEXT           "Alt+Enter switches between the window and fullscreen at any time.",
                    -1, 16, 70, 348, 8
    LTEXT           "Start f&ullscreen:", -1, 16, 86, 192, 8
    COMBOBOX        IDC_S_AUTOFS, 214, 84, 150, 80,
                    CBS_DROPDOWNLIST | CBS_HASSTRINGS | WS_VSCROLL | WS_TABSTOP | WS_GROUP
    LTEXT           "Fullscreen &renderer:", -1, 16, 102, 192, 8
    COMBOBOX        IDC_S_RENDERER, 214, 100, 150, 80,
                    CBS_DROPDOWNLIST | CBS_HASSTRINGS | WS_VSCROLL | WS_TABSTOP
END

/* ── PAGE: GRAPHICS (was Display) ───────────────────────────────────────────────
   s81 (#159): Aspect is a five-way setting (the View menu's list), so it is a
   dropdown -- a checkbox could not show or set 16:9. */
IDD_PAGE_DISPLAY DIALOGEX 0, 0, 380, 250
STYLE DS_SETFONT | DS_CONTROL | WS_CHILD
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    GROUPBOX        "Image", -1, 6, 4, 368, 114
    LTEXT           "How the program's picture is scaled, shaped and coloured on your screen.",
                    -1, 16, 18, 348, 8
    LTEXT           "&Scaler:", -1, 16, 36, 192, 8
    COMBOBOX        IDC_S_SCALER, 214, 34, 150, 80,
                    CBS_DROPDOWNLIST | CBS_HASSTRINGS | WS_VSCROLL | WS_TABSTOP | WS_GROUP
    LTEXT           "&Filtering:", -1, 16, 52, 192, 8
    COMBOBOX        IDC_S_FILTER, 214, 50, 150, 80,
                    CBS_DROPDOWNLIST | CBS_HASSTRINGS | WS_VSCROLL | WS_TABSTOP
    LTEXT           "&Aspect ratio:", -1, 16, 68, 192, 8
    COMBOBOX        IDC_S_ASPECT, 214, 66, 150, 80,
                    CBS_DROPDOWNLIST | CBS_HASSTRINGS | WS_VSCROLL | WS_TABSTOP
    /* #229: the colour filter. */
    LTEXT           "C&olour filter:", -1, 16, 84, 192, 8
    COMBOBOX        IDC_S_TINT, 214, 82, 150, 80,
                    CBS_DROPDOWNLIST | CBS_HASSTRINGS | WS_VSCROLL | WS_TABSTOP
    LTEXT           "Frame s&kip:", -1, 16, 100, 192, 8
    COMBOBOX        IDC_S_FRAMESKIP, 214, 98, 150, 80,
                    CBS_DROPDOWNLIST | CBS_HASSTRINGS | WS_VSCROLL | WS_TABSTOP

    /* #217: buffered drawing and on-screen messages both default on. */
    GROUPBOX        "Drawing", -1, 6, 124, 368, 44
    CONTROL         "Force &VSync (every frame)", IDC_S_VSYNC, "Button",
                    BS_AUTOCHECKBOX | WS_TABSTOP | WS_GROUP, 16, 138, 170, 10
    CONTROL         "&Draw off-screen first (no flicker)", IDC_S_BUFFERED, "Button",
                    BS_AUTOCHECKBOX | WS_TABSTOP, 192, 138, 170, 10
    CONTROL         "&Blink the text-mode cursor", IDC_S_BLINKCURSOR, "Button",
                    BS_AUTOCHECKBOX | WS_TABSTOP, 16, 150, 170, 10
    CONTROL         "Show on-screen &messages", IDC_S_OSD, "Button",
                    BS_AUTOCHECKBOX | WS_TABSTOP, 192, 150, 170, 10
END

/* ── PAGE: AUDIO ────────────────────────────────────────────────────────────────
   Defaults describe the card we really emulate: SB16 at 220/IRQ 5/DMA 1, OPL3,
   44100 Hz. See the note over SET_DEFS in src/host/settings.h. The cards' jumpers
   are on the next tab, Sound Cards (split so the dialog fits 800 x 600). */
IDD_PAGE_AUDIO DIALOGEX 0, 0, 380, 250
STYLE DS_SETFONT | DS_CONTROL | WS_CHILD
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    /* #234: WinMM or DirectSound; opened once, so it applies at the next program. */
    GROUPBOX        "Output", -1, 6, 4, 368, 90
    LTEXT           "How sound reaches this PC's speakers. A change of output or sample "
                    "rate applies to programs started afterwards.",
                    -1, 16, 18, 348, 16
    LTEXT           "Output &via:", -1, 16, 44, 192, 8
    COMBOBOX        IDC_S_AUDIOAPI, 214, 42, 150, 80,
                    CBS_DROPDOWNLIST | CBS_HASSTRINGS | WS_VSCROLL | WS_TABSTOP | WS_GROUP
    LTEXT           "Sample &rate (Hz):", -1, 16, 60, 192, 8
    COMBOBOX        IDC_S_RATE, 214, 58, 150, 80,
                    CBS_DROPDOWNLIST | CBS_HASSTRINGS | WS_VSCROLL | WS_TABSTOP
    LTEXT           "&Master volume:", -1, 16, 76, 192, 8
    EDITTEXT        IDC_S_VOLUME, 214, 74, 40, 13, ES_AUTOHSCROLL | ES_NUMBER | WS_TABSTOP
    LTEXT           "%", -1, 258, 76, 10, 8
    CONTROL         "M&ute", IDC_S_MUTE, "Button",
                    BS_AUTOCHECKBOX | WS_TABSTOP, 290, 75, 74, 10

    GROUPBOX        "Music", -1, 6, 100, 368, 68
    LTEXT           "Ad&Lib / OPL chip:", -1, 16, 116, 192, 8
    COMBOBOX        IDC_S_OPL, 214, 114, 150, 80,
                    CBS_DROPDOWNLIST | CBS_HASSTRINGS | WS_VSCROLL | WS_TABSTOP | WS_GROUP
    LTEXT           "M&IDI:", -1, 16, 132, 192, 8
    COMBOBOX        IDC_S_MIDI, 214, 130, 150, 80,
                    CBS_DROPDOWNLIST | CBS_HASSTRINGS | WS_VSCROLL | WS_TABSTOP
    LTEXT           "SoundF&ont:", -1, 16, 148, 60, 8
    EDITTEXT        IDC_S_SOUNDFONT, 80, 146, 284, 13, ES_AUTOHSCROLL | WS_TABSTOP
END

/* ── PAGE: SOUND CARDS (split from Audio so the dialog fits 800 x 600) ─────────
   A card's jumpers (address, IRQ, DMA) share one row inside the control column.
   #235: the GUS's jumpers and the MPU-401's port. */
IDD_PAGE_CARDS DIALOGEX 0, 0, 380, 250
STYLE DS_SETFONT | DS_CONTROL | WS_CHILD
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    GROUPBOX        "Sound Blaster", -1, 6, 4, 368, 64
    LTEXT           "A program must be set up with the same address, IRQ and DMA as the "
                    "card here.",
                    -1, 16, 18, 348, 8
    LTEXT           "Mo&del:", -1, 16, 34, 192, 8
    COMBOBOX        IDC_S_SBMODEL, 214, 32, 150, 80,
                    CBS_DROPDOWNLIST | CBS_HASSTRINGS | WS_VSCROLL | WS_TABSTOP | WS_GROUP
    LTEXT           "&Address, IRQ, DMA:", -1, 16, 50, 192, 8
    COMBOBOX        IDC_S_SBADDR, 214, 48, 48, 80,
                    CBS_DROPDOWNLIST | CBS_HASSTRINGS | WS_VSCROLL | WS_TABSTOP
    COMBOBOX        IDC_S_SBIRQ, 266, 48, 48, 80,
                    CBS_DROPDOWNLIST | CBS_HASSTRINGS | WS_VSCROLL | WS_TABSTOP
    COMBOBOX        IDC_S_SBDMA, 318, 48, 46, 80,
                    CBS_DROPDOWNLIST | CBS_HASSTRINGS | WS_VSCROLL | WS_TABSTOP

    GROUPBOX        "Other devices", -1, 6, 74, 368, 66
    LTEXT           "PC spea&ker:", -1, 16, 90, 192, 8
    COMBOBOX        IDC_S_SPEAKER, 214, 88, 150, 80,
                    CBS_DROPDOWNLIST | CBS_HASSTRINGS | WS_VSCROLL | WS_TABSTOP | WS_GROUP
    CONTROL         "&Gravis Ultrasound -- address, IRQ, DMA:", IDC_S_GUS, "Button",
                    BS_AUTOCHECKBOX | WS_TABSTOP, 16, 105, 192, 10
    COMBOBOX        IDC_S_GUSADDR, 214, 104, 48, 80,
                    CBS_DROPDOWNLIST | CBS_HASSTRINGS | WS_VSCROLL | WS_TABSTOP
    COMBOBOX        IDC_S_GUSIRQ, 266, 104, 48, 80,
                    CBS_DROPDOWNLIST | CBS_HASSTRINGS | WS_VSCROLL | WS_TABSTOP
    COMBOBOX        IDC_S_GUSDMA, 318, 104, 46, 80,
                    CBS_DROPDOWNLIST | CBS_HASSTRINGS | WS_VSCROLL | WS_TABSTOP
    LTEXT           "MPU-401 &port:", -1, 16, 122, 192, 8
    COMBOBOX        IDC_S_MPUADDR, 214, 120, 48, 80,
                    CBS_DROPDOWNLIST | CBS_HASSTRINGS | WS_VSCROLL | WS_TABSTOP
END

/* ── PAGE: INPUT ────────────────────────────────────────────────────────────────
   Sensitivity is LIVE; the rest is stored only. (#218: the hide-cursor box is gone --
   the pointer hides itself after 5 s still over the video.) */
IDD_PAGE_INPUT DIALOGEX 0, 0, 380, 250
STYLE DS_SETFONT | DS_CONTROL | WS_CHILD
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    GROUPBOX        "Mouse", -1, 6, 4, 368, 74
    LTEXT           "Click the video to capture the mouse, and press the Windows key to "
                    "release it. In seamless mode the program's pointer follows Windows' "
                    "own, and no capture is needed.",
                    -1, 16, 18, 348, 16
    CONTROL         "&Seamless mouse (no capture needed)", IDC_S_SEAMLESS, "Button",
                    BS_AUTOCHECKBOX | WS_TABSTOP | WS_GROUP, 16, 40, 348, 10
    LTEXT           "Se&nsitivity (100 = the mouse's own movement, unscaled):",
                    -1, 16, 58, 192, 8
    EDITTEXT        IDC_S_MSENS, 214, 56, 40, 13, ES_AUTOHSCROLL | ES_NUMBER | WS_TABSTOP
    LTEXT           "%", -1, 258, 58, 10, 8

    GROUPBOX        "Keyboard", -1, 6, 84, 368, 50
    LTEXT           "&Layout:", -1, 16, 100, 192, 8
    COMBOBOX        IDC_S_KBLAYOUT, 214, 98, 150, 80,
                    CBS_DROPDOWNLIST | CBS_HASSTRINGS | WS_VSCROLL | WS_TABSTOP | WS_GROUP
    LTEXT           "T&ypematic rate (key repeat):", -1, 16, 116, 192, 8
    EDITTEXT        IDC_S_TYPEMATIC, 214, 114, 40, 13, ES_AUTOHSCROLL | ES_NUMBER | WS_TABSTOP
    LTEXT           "characters per second", -1, 258, 116, 106, 8

    GROUPBOX        "Joystick", -1, 6, 140, 368, 48
    LTEXT           "&Type:", -1, 16, 156, 192, 8
    COMBOBOX        IDC_S_JOYTYPE, 214, 154, 150, 80,
                    CBS_DROPDOWNLIST | CBS_HASSTRINGS | WS_VSCROLL | WS_TABSTOP | WS_GROUP
    CONTROL         "&Map to an XInput gamepad", IDC_S_JOYPAD, "Button",
                    BS_AUTOCHECKBOX | WS_TABSTOP, 16, 172, 348, 10
END

/* ── PAGE: DRIVES ───────────────────────────────────────────────────────────────
   The persistent form of what used to be the Drive menu's Mount... commands. There
   is no Browse button yet here: typing a path works. */
IDD_PAGE_DRIVES DIALOGEX 0, 0, 380, 250
STYLE DS_SETFONT | DS_CONTROL | WS_CHILD
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    GROUPBOX        "Mounted media", -1, 6, 4, 368, 80
    LTEXT           "Leave a field empty to leave that drive unmounted.", -1, 16, 18, 348, 8
    LTEXT           "Drive &C: folder:", -1, 16, 34, 62, 8
    EDITTEXT        IDC_S_DRIVEC, 80, 32, 284, 13, ES_AUTOHSCROLL | WS_TABSTOP | WS_GROUP
    LTEXT           "Floppy &A: image:", -1, 16, 50, 62, 8
    EDITTEXT        IDC_S_FLOPPYA, 80, 48, 284, 13, ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT           "CD-ROM &D: image:", -1, 16, 66, 62, 8
    EDITTEXT        IDC_S_CDROM, 80, 64, 284, 13, ES_AUTOHSCROLL | WS_TABSTOP

    GROUPBOX        "Startup", -1, 6, 90, 368, 34
    LTEXT           "Boot &from:", -1, 16, 106, 192, 8
    COMBOBOX        IDC_S_BOOTFROM, 214, 104, 150, 80,
                    CBS_DROPDOWNLIST | CBS_HASSTRINGS | WS_VSCROLL | WS_TABSTOP | WS_GROUP
END
