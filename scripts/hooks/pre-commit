#!/usr/bin/env bash
#
# pre-commit -- refuse a commit whose C files are not in the house style.
#
# Enable with `git config core.hooksPath scripts/hooks`. It checks the staged version of each
# staged .c and .h file, so what is checked is what is committed. Fix with
# `scripts/style.sh --fix FILE...`, or skip once with `git commit --no-verify`.
#
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"

files=()
while IFS= read -r -d '' path; do
    case "$path" in
        tools/style/fixtures/*) ;;
        src/*.c|src/*.h|sdk/*.c|sdk/*.h|tests/*.c|tests/*.h|tools/*.c|tools/*.h) files+=("$path") ;;
    esac
done < <(git diff --cached --name-only --diff-filter=ACMR -z)

if [[ ${#files[@]} -eq 0 ]]; then
    exit 0
fi

# The staged content, under the same names, so the tool sees exactly what is committed.
staged="$(mktemp -d)"
trap 'rm -rf "$staged"' EXIT
for path in "${files[@]}"; do
    mkdir -p "$staged/$(dirname "$path")"
    git show ":$path" > "$staged/$path"
done

tool="$PWD/tools/style/style.py"
if ! (cd "$staged" && python3 "$tool" --check "${files[@]}"); then
    echo "pre-commit: not in the house style -- run scripts/style.sh --fix on the files above" >&2
    exit 1
fi
