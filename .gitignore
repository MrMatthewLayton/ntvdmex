# Build output
/build/
*.o
*.obj
*.exe

# VM: disk images, install media — NEVER commit these (large + licensed media)
/vm/

# Real DOS games (DOS/4GW + real-mode) staged for the acceptance tests — licensed, large
/games/
*.iso
*.qcow2
*.vmdk
*.img

# DOS oracle scratch: install control floppies, source-disk copies, run temporaries
/scripts/dosoracle/_build/

# Native off-VM test binaries: rebuilt by tests/probes/dos/run.sh on every run, so
# tracking them means binary churn in every commit. Repo convention is that the
# guest .COM binaries ARE tracked (they cannot be assembled on the target) and
# these are NOT.
/tests/unit/*_test

# Scratch kernel-debugger scripts that predate this branch and are not part of it
/scripts/kd_*.py
/scripts/trace_break.py

# Generated DOS test stubs (reproducible via tools/wowprobe/make-*.sh)
/tools/wowprobe/dosstub.com
/tools/wowprobe/dosstub.exe

# Reverse-engineering scratch: extracted Microsoft XP binaries — NEVER commit
# (copyrighted). Findings/offsets go in docs/research/, not the binaries.
/reverse/

# Python bytecode cache (scripts/xp.py etc.)
__pycache__/
*.pyc

# Editor / OS cruft
.DS_Store
*.swp
.vscode/
.idea/
.studio/*.user.json

# Guest binaries extracted from the vendored MS-DOS images (see
# tests/probes/dos/extract-dos-file.py) -- Microsoft's, not ours to redistribute unpacked.
guest/

# Third-party reference screenshots (MobyGames) used to eyeball our rendering.
# Not ours to redistribute -- the repo is public.
/doom-screenshots/

# The score tool's last-good probe readings. Regenerated on every run; it exists
# only so a checkout without guest/ (which is gitignored) can still score with a
# STALE marker rather than failing. Committing it would make one machine's
# measurement look like the project's.
tools/score/probe-cache.json

# PCem ROM pack: real BIOS / video BIOS / sound ROMs, licensed and large. Kept as an
# ORACLE, never committed. ibm_vga.bin is the genuine IBM VGA BIOS (24KB at file
# offset 0x2000) -- the thing scripts/dosoracle's docstring says we lack, since QEMU
# runs SeaVGABIOS and "for INT 10h it is only another reimplementation's opinion".
/PCem-ROMs-master/

# Bare-metal rig result logs, archived locally by hand or by bmqueue.sh ARCHIVE=.
# Large, regenerated every run, and not ours to redistribute (they quote guest memory).
/runs/

# PCem itself (macOS build + source for reference): the user's copies, not ours to ship.
/pcem/
/dist/

# -- s93 #322 phase 1: LOCAL-ONLY material (kept on disk, never committed) --
# Non-product: rig/oracle tooling, session notes, research, demos, scratch.
/docs/log/
/docs/research/
/docs/spikes/
