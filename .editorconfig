# The parts of docs/STYLE.md an editor can do. The rest: scripts/style.sh --fix.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{c,h,S,asm,inc,py,sh,cmake,rc}]
indent_style = space
indent_size = 4
max_line_length = 100

[CMakeLists.txt]
indent_style = space
indent_size = 4

[*.{yml,yaml}]
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false

# Batch files are stored LF too: scripts/package.sh writes them CRLF into the zip.
